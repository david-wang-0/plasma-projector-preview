#!/bin/sh
# Live, GPU-scaled view of another screen (the projector) in a window on the laptop.
# The work is done by the Plasma widget local.projectorpreview (plasmoid/) and the QML
# plugin local.outputstream (plugin/, installed by build.sh); see README.md.
QML_IMPORT_PATH="$HOME/.local/lib/qt6/qml${QML_IMPORT_PATH:+:$QML_IMPORT_PATH}"
export QML_IMPORT_PATH
exec plasmawindowed local.projectorpreview "$@"
